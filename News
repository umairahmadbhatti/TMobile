# COMMAND ----------

from typing import Optional

#------------For UID----------------#

def normalize_url(url: Optional[str]) -> Optional[str]:
    """
    Return a normalized URL without query/fragment and without trailing slash.
    This collapses tracker variants like ?utm_source=... so duplicates match.
    """
    if not url:
        return None
    p = urlparse(url.strip())
    scheme = (p.scheme or "https").lower()
    netloc = (p.netloc or "").lower()
    path = p.path or "/"
    if path != "/" and path.endswith("/"):
        path = path[:-1]
    return f"{scheme}://{netloc}{path}"

def safe_published_iso(published_at: Optional[str], fallback_dt: datetime) -> str:
    """
    Ensure we have a stable ISO string for the published time.
    If NewsAPI omitted it or it's malformed, fall back to current UTC.
    """
    try:
        if published_at:
            return str(published_at).strip()
    except Exception:
        pass
    return fallback_dt.isoformat()

def build_uid(url: Optional[str], published_at_iso: str) -> str:
    """
    Build a stable UID = SHA256(normalized_url + '_' + published_at_iso).
    If URL is missing, caller should decide an alternate (e.g., title-based) UID.
    """
    norm = normalize_url(url) or ""
    return hashlib.sha256(f"{norm}_{published_at_iso}".encode("utf-8")).hexdigest()

# COMMAND ----------

#---------- Fetch News Articles---------------#

def fetch_news_for_keyword(keyword: str, start: datetime, end: datetime):
    """
    Pull paginated results from NewsAPI for a single keyword within [start, end].
    Handles transient errors with exponential backoff.
    """
    batch = []                                    # list of article dicts to return
    for page in range(1, MAX_PAGES + 1):          # iterate pages up to cap
        for attempt in range(RETRY_LIMIT):        # transient error retries
            try:
                # Build request params
                params = {
                    "q": keyword,                 # search query
                    "from": start.isoformat(),    # inclusive lower bound
                    "to": end.isoformat(),        # inclusive upper bound
                    "language": "en",             # English articles
                    "sortBy": "publishedAt",      # time sort
                    "pageSize": MAX_PAGE_SIZE,    # number of results per page
                    "page": page,                 # current page
                    "apiKey": NEWS_API_KEY        # auth
                }
                # Make HTTP call (30s timeout is conservative)
                r = requests.get("https://newsapi.org/v2/everything", params=params, timeout=30)
                if r.status_code == 200:
                    data = r.json()                               # parse JSON payload
                    articles = data.get("articles", [])           # list of article dicts
                    now_iso = datetime.utcnow().isoformat()       # consistent fetched_at for this page

                    for a in articles:
                        # Extract fields
                        title = a.get("title")
                        url = a.get("url")
                        pub_iso = safe_published_iso(a.get("publishedAt"), fallback_dt=datetime.utcnow())
                        uid = build_uid(url, pub_iso)     # stable dedup key
                        if not url:
                            title_key = (title or "").strip()
                            uid = hashlib.sha256(f"titleonly_{title_key}_{pub_iso}".encode("utf-8")).hexdigest()

                        # Append raw record (entity set later in the outer loop)
                        batch.append({
                            "uid": uid,
                            "entity": None,                       # filled when looping entities
                            "keyword": keyword,
                            "title": title,
                            "description": a.get("description"),
                            "author": a.get("author"),
                            "source": (a.get("source") or {}).get("name"),
                            "url": url,
                            "normalized_url": normalize_url(url),
                            "publishedAt": a.get("publishedAt"),
                            "fetched_at": now_iso,
                        })

                    # If fewer than a full page returned, we've reached the end.
                    if len(articles) < MAX_PAGE_SIZE:
                        return batch

                    # Break out of retry loop on success
                    break
                else:
                    # Log error status and back off; continue retry loop
                    print(f"[{keyword}] page {page} → HTTP {r.status_code}: {r.text[:200]}")
                    time.sleep(2 ** attempt)

            except Exception as e:
                # Log exception and back off; continue retry loop
                print(f"[{keyword}] page {page} attempt {attempt+1}/{RETRY_LIMIT} error: {e}")
                time.sleep(2 ** attempt)

        # Throttle between pages to respect quota (tune for paid tier)
        time.sleep(REQUEST_DELAY_S)

    return batch


#-------Loop all entities/keywords---------#

rows = []                                            # accumulator for all articles
for entity, keywords in ENTITY_KEYWORDS.items():     # iterate entities
    for kw in keywords:                              # iterate each keyword per entity
        print(f"🔎 {entity} | {kw}")
        items = fetch_news_for_keyword(kw, FROM_DATE, TO_DATE)
        for it in items:
            it["entity"] = entity                    # stamp entity name now
        rows.extend(items)                           # add to accumulator
        time.sleep(REQUEST_DELAY_S)                # small delay between keyword calls


#--------Pandas Dedup---------#

pdf = pd.DataFrame(rows)                             # convert to Pandas

#display(pdf)

if pdf.empty:
    print("No new rows fetched.")
    dbutils.notebook.exit("Notebook finished early — success.")
else:
    # Drop duplicates by UID to collapse cross-keyword duplicates
    pdf.drop_duplicates(subset=["uid", "entity"], inplace=True)
    print(f"Fetched rows (post in-memory dedup): {len(pdf)}")

# Convert to Spark DataFrame for scalable transforms & Snowflake write
df_raw = spark.createDataFrame(pdf)                              # Pandas → Spark DF
df_raw = df_raw.dropDuplicates(["uid", "entity"])                # extra safety dedup in Spark

#display(df_raw)

# COMMAND ----------

display(df_raw)

# COMMAND ----------

# -------------- Cleaning / transformations -----------------#
# Rename to standardized column names, add empty columns for future needs,
# cast timestamps, and select final column order
df_int = (
    df_raw.withColumnRenamed(
        "entity", "executive_org_name"
    )  # entity → organization
    .withColumnRenamed("keyword", "search_term")  # keyword → search_term
    .withColumnRenamed("title", "article_title")  # title → article_title
    .withColumnRenamed(
        "description", "article_summary"
    )  # description → article_summary
    .withColumnRenamed("author", "article_author")  # author → article_author
    .withColumnRenamed("source", "source_name")  # source → source_name
    .withColumnRenamed("url", "article_url")  # url → article_url
    .withColumnRenamed(
        "publishedAt", "published_datetime_utc"
    )  # publishedAt → published_at
    .withColumnRenamed(
        "fetched_at", "load_datetime_utc"
    )  # fetched_at → ingested_at
    # # Add placeholder columns for downstream enrichment
    # .withColumn("sentiment",     lit(None).cast(StringType()))  # empty sentiment column
    # .withColumn("theme", lit(None).cast(StringType()))  # empty theme column
    # Cast string timestamps to Spark timestamps (let Snowflake map to TIMESTAMP_NTZ)
    .withColumn(
        "published_datetime_utc", to_timestamp(col("published_datetime_utc"))
    )
    .withColumn("load_datetime_utc", to_timestamp(col("load_datetime_utc")))
    # Reorder columns to a clean canonical schema (include normalized_url for audit)
    .select(
        "uid",
        "executive_org_name",
        "article_title",
        "article_summary",
        # "sentiment",
        # "theme",
        "article_author",
        "source_name",
        "article_url",
        "published_datetime_utc",
        "load_datetime_utc",
    )
    .dropDuplicates(["uid", "executive_org_name"])  # final guard against dupes pre-write
)

# Add Pacific dateime columns
df_final = (
    df_int
    # Convert from UTC → Pacific; result is a timestamp representing local PT clock time
    .withColumn(
        "published_datetime_pt",
        from_utc_timestamp(col("published_datetime_utc"), "America/Los_Angeles"),
    ).withColumn(
        "load_datetime_pt",
        from_utc_timestamp(col("load_datetime_utc"), "America/Los_Angeles"),
    )
)

# COMMAND ----------

display(df_final)

