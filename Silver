def _strip_code_fences(s: str) -> str:
    s = s.strip()
    s = re.sub(r"```(?:json)?\s*", "", s, flags=re.I)
    s = s.replace("```", "")
    return s.strip()

def _extract_content(resp):
    # Prefer JSON; fall back to text
    try:
        data = resp.json()
        if isinstance(data, dict):
            if "choices" in data:
                return data["choices"][0]["message"]["content"]
            if "output_text" in data:
                return data["output_text"]
            if "predictions" in data:
                return json.dumps(data["predictions"])
            if "data" in data:
                return data["data"] if isinstance(data["data"], str) else json.dumps(data["data"])
            return json.dumps(data)
        if isinstance(data, list):
            return json.dumps(data)
    except Exception:
        pass
    return resp.text

def _extract_tag_block(s: str) -> Optional[str]:
    s = _strip_code_fences(s)
    m = re.search(re.escape(JSON_START_TAG) + r"(.*?)" + re.escape(JSON_END_TAG), s, flags=re.S)
    if m:
        return m.group(1).strip()
    return None

def _parse_json_list(content_text: str):
    """
    Try in order:
    1) Parse <json>...</json> inner text
    2) Parse entire content
    3) Parse first [...] array in content
    """
    # 1) tagged block
    inner = _extract_tag_block(content_text)
    if inner is not None:
        try:
            obj = json.loads(inner)
            if isinstance(obj, list):
                return obj
            if isinstance(obj, dict):
                return [obj]
        except Exception:
            pass
    # 2) whole content
    s = _strip_code_fences(content_text)
    try:
        obj = json.loads(s)
        if isinstance(obj, list):
            return obj
        if isinstance(obj, dict):
            for k in ("items","results","data","output","predictions"):
                if k in obj and isinstance(obj[k], list):
                    return obj[k]
            return [obj]
    except Exception:
        pass
    # 3) first [...] array
    m2 = re.search(r"\[\s*\{.*?\}\s*\]", s, flags=re.S)
    if m2:
        try:
            return json.loads(m2.group(0))
        except Exception:
            pass
    return None

