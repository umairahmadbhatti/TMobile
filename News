#------------ Write To Snowflake; Staging Table -----------#

from pyspark.sql import DataFrame as SparkDataFrame

# ---------------------------
# Overwrite stage table with the current batch (Spark → Snowflake)
# Using the Spark connector for the write
# ---------------------------
(
    df_final.write
        .format("snowflake")
        .option("sfURL", f"tmobile.west-us-2.privatelink.snowflakecomputing.com")
        .option("sfUser", snflk_conn.user)
        .option("sfWarehouse", snflk_conn.warehouse)
        .option("sfDatabase", snflk_conn.database)
        .option("sfSchema", snflk_conn.schema)
        .option("sfAuthenticator", "oauth")
        .option("sfToken", access_token)
        .option("dbtable", 'NONSPRINKLR_NEWS_ARTICLES_STAGE')
        .mode("overwrite")
        .save()
)
print("Wrote batch to Snowflake stage (via Spark).")

# COMMAND ----------

#------------ Write To Snowflake; Upsert into Final Table -----------#

# ---------------------------
# Run MERGE in Snowflake using the existing Python connection
# ---------------------------
merge_sql = f"""
MERGE INTO BDM_PPDA_DB.PROD_BOARD_T.NONSPRINKLR_NEWS_ARTICLES t
USING BDM_PPDA_DB.PROD_BOARD_T.NONSPRINKLR_NEWS_ARTICLES_STAGE s
  ON t.UID = s.UID
  AND t.EXECUTIVE_ORG_NAME = s.EXECUTIVE_ORG_NAME
WHEN NOT MATCHED THEN INSERT (
  UID, EXECUTIVE_ORG_NAME,  
  ARTICLE_TITLE, ARTICLE_SUMMARY, ARTICLE_AUTHOR, 
  SOURCE_NAME, ARTICLE_URL, 
  PUBLISHED_DATETIME_UTC, LOAD_DATETIME_UTC,
  PUBLISHED_DATETIME_PT, LOAD_DATETIME_PT
) VALUES (
  s.UID, s.EXECUTIVE_ORG_NAME,  
  s.ARTICLE_TITLE, s.ARTICLE_SUMMARY, s.ARTICLE_AUTHOR, 
  s.SOURCE_NAME, s.ARTICLE_URL, 
  s.PUBLISHED_DATETIME_UTC, s.LOAD_DATETIME_UTC,
  s.PUBLISHED_DATETIME_PT, s.LOAD_DATETIME_PT
);
"""

cur = snflk_conn.cursor()
cur.execute(merge_sql)
cur.close()

print("Snowflake MERGE complete.")
