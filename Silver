    src_by_id = {it["id"]: {"MESSAGE_CONTENT": it["text"], "PLATFORM": it.get("platform")} for it in buf}
    for r in results:
        topics     = (r.get("topics") or [])[:4]
        llm_topics = (r.get("llm_topics") or [])[:4]
        ents       = (r.get("entities") or [])[:4]
        src = src_by_id.get(r["id"], {})
        yield (
            str(r["id"]),
            src.get("MESSAGE_CONTENT"),
            src.get("PLATFORM"),
            r.get("summary"),
            list_to_csv(topics),
            list_to_csv(llm_topics),
            json.dumps(topics, ensure_ascii=False),
            r.get("pillar"),
            r.get("sentiment_label"),
            list_to_csv(ents),
            list_to_csv(llm_topics),
