            llm_topics[2] if len(llm_topics)>2 else None,
            llm_topics[3] if len(llm_topics)>3 else None,
            now_str
        )

    for (bid, err) in errors:
        src = src_by_id.get(bid, {})
        yield (
            str(bid),
            src.get("MESSAGE_CONTENT"),
            src.get("PLATFORM"),
            None, None, None, json.dumps([], ensure_ascii=False), None, None, None, None,
