def normalize_text(s: str) -> str:
    s = re.sub(r"\s+", " ", s or "").strip()
    return s

def content_hash(text: str, prompt_version: str) -> str:
    return hashlib.sha256((normalize_text(text) + "|" + prompt_version).encode("utf-8")).hexdigest()

def chunk(seq, n):
    for i in range(0, len(seq), n):
        yield seq[i:i+n]

class SimpleRateLimiter:
    """Very small in-memory sliding window limiter for RPM."""
    def __init__(self, rpm: int, window_sec: int = 60):
        self.rpm = rpm
        self.window = window_sec
        self.calls = []
    def acquire(self):
        now = time.time()
        self.calls = [t for t in self.calls if now - t < self.window]
        if len(self.calls) >= self.rpm:
            sleep_for = self.window - (now - self.calls[0]) + 0.05
            time.sleep(max(0, sleep_for))
        self.calls.append(time.time())

